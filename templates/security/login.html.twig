{% extends 'basic.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {{ parent() }}
{% endblock %}

{% block body %}
    <section class="flex min-h-screen items-center justify-center px-4">
        <div class="w-full max-w-sm rounded-lg bg-white p-6 shadow dark:border dark:border-gray-700 dark:bg-gray-800 sm:p-8">
            <h1 class="mb-6 text-xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white">
                Hautesmahaiak - Kudeaketa
            </h1>

            {% if error %}
                <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 dark:bg-gray-700 dark:text-red-400" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-4">
                <div>
                    <label for="username" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">Erabiltzailea</label>
                    <input type="text" name="_username" id="username" value="{{ last_username }}" autocomplete="username" required autofocus
                           class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                </div>
                <div>
                    <label for="password" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">Pasahitza</label>
                    <input type="password" name="_password" id="password" autocomplete="current-password" required
                           class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="w-full rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                    Sartu
                </button>
            </form>
        </div>
    </section>
{% endblock %}
