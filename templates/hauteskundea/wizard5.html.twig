{% extends 'base.html.twig' %}

{% block title %}{{ "Hauteskunde berria" | trans }}{% endblock %}

{% block body %}
<turbo-frame id="wizard-form" class="aria-busy:opacity-50">
    <div class="mt-4 relative w-full max-w-screen-2xl mx-auto h-full overflow-y-auto bg-gray-50 dark:bg-gray-900">

        {% include 'hauteskundea/_steeper.html.twig' with {'steep':5 } %}

        <hr/>
        <div class="mt-8">
            {{ include('hauteskundea/_form_wizard5.html.twig') }}
        </div>
    </div>
</turbo-frame>
{% endblock %}



{% block stream_success %}

    <turbo-stream action="replace" target="wizard-form">
        <template>
            {{ include('hauteskundea/_form_wizard5.html.twig') }}
        </template>
    </turbo-stream>

{% endblock %}
